@startuml RecuperarPassword
title Módulo — Recuperar contraseña
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package "Controller" {
  class Router <<Controller>> {
    -_crear_recuperar() : Vista
  }
}

package "View" {
  class RecuperarPasswordView <<View>> {
    +view : ft.View
    -_vm : RecuperarPasswordViewModel
    -_indicador : IndicadorPasos
    -_banner : BannerAlerta
    -_banner_codigo : BannerAlerta
    -_correo : CampoFormulario
    -_codigo : CampoFormulario
    -_password : CampoFormulario
    -_confirmar : CampoFormulario
    -_requisitos : ListaRequisitos
    -_paso_correo : ft.Column
    -_paso_codigo : ft.Column
    -_paso_password : ft.Column
    -_pantalla_exito : PantallaExito
    +montar()
    +desmontar()
    -_on_cambio()
    -_render()
    -_on_principal(e : ft.Event)
    -_on_reenviar(e : ft.Event)
    -_on_regresar(e : ft.Event)
    -_on_ir_a_login(e : ft.Event)
  }
  class IndicadorPasos <<View>> {
    +/texto : str
    +sincronizar(paso : int)
  }
  class CampoFormulario <<View>>
  class ListaRequisitos <<View>>
  class BannerAlerta <<View>>
  class PantallaExito <<View>>
}

package "ViewModel" {
  enum Paso {
    CORREO = 1
    CODIGO = 2
    NUEVA_PASSWORD = 3
    COMPLETADO = 4
  }
  class RecuperarPasswordViewModel <<ViewModel>> {
    +paso : Paso
    +correo : str
    +codigo : str
    +password : str
    +confirmar_password : str
    +error_correo : str
    +error_codigo : str
    +codigo_invalido : bool
    +error_password : str
    +error_confirmar : str
    +alerta : Alerta
    +cargando : bool
    -_auth : AuthService
    -_emqx : EmqxAdminService
    -_reloj : Callable[[], float]
    -_vence_en : float
    -_temporizador : asyncio.Task
    -_codigo_verificado : bool
    +/numero_paso : int
    +/total_pasos : int
    +/correo_normalizado : str
    +/segundos_restantes : int
    +/texto_vencimiento : str
    +/codigo_vencido : bool
    +/mostrar_error_codigo : bool
    +/requisitos_password : list[tuple[str, bool]]
    +/puede_enviar : bool
    +set_correo(valor : str)
    +set_codigo(valor : str)
    +set_password(valor : str)
    +set_confirmar_password(valor : str)
    +enviar_codigo()
    +reenviar_codigo()
    +verificar_codigo()
    +guardar_password()
    +regresar()
    +ir_a_login()
    +liberar()
    -_solicitar_codigo() : bool
    -_sincronizar_mqtt()
    -_revalidar_password()
    -_reiniciar(alerta : Alerta)
    -_iniciar_temporizador()
    -_detener_temporizador()
    -_contar()
  }
  class Alerta <<DTO>>
}

package "Model" {
  class AuthService <<Service>> {
    +solicitar_restablecimiento(correo : str)
    +verificar_codigo_recuperacion(correo : str, codigo : str)
    +confirmar_nueva_password(nueva : str)
    +cancelar_recuperacion()
  }
  class EmqxAdminService <<Service>> {
    +crear_credencial(correo : str, contraseña : str)
  }
  class supabase_client <<Factory>> {
    +{static} get_supabase() : Client
  }
  package "Excepciones" {
    class AuthServiceError <<Exception>>
    class CodigoInvalidoError <<Exception>>
    class LimiteCorreosError <<Exception>>
    class PasswordDebilError <<Exception>>
    class PasswordRepetidaError <<Exception>>
    class ServicioNoDisponibleError <<Exception>>
    class SinSesionError <<Exception>>
  }
}

package "core" {
  class Observable <<Core>>
  class config <<Config>> {
    +{static} VIGENCIA_CODIGO_SEGUNDOS : int
  }
  class validadores <<Utility>> {
    +{static} validar_correo_institucional(correo : str) : str
    +{static} normalizar_correo(correo : str) : str
    +{static} estado_requisitos_password(password : str) : dict
  }
}

Router ..> RecuperarPasswordViewModel : <<create>>
Observable <|-- RecuperarPasswordViewModel
RecuperarPasswordView --> RecuperarPasswordViewModel : _vm / add_listener
RecuperarPasswordView *-- IndicadorPasos
RecuperarPasswordView *-- "4" CampoFormulario
RecuperarPasswordView *-- ListaRequisitos
RecuperarPasswordView *-- "2" BannerAlerta
RecuperarPasswordView *-- PantallaExito
RecuperarPasswordViewModel --> Paso : paso
RecuperarPasswordViewModel --> AuthService : _auth
RecuperarPasswordViewModel --> EmqxAdminService : _sincronizar_mqtt()
RecuperarPasswordViewModel ..> validadores
RecuperarPasswordViewModel ..> config
RecuperarPasswordViewModel ..> Alerta
AuthService ..> supabase_client
AuthServiceError <|-- CodigoInvalidoError
AuthServiceError <|-- LimiteCorreosError
AuthServiceError <|-- PasswordDebilError
AuthServiceError <|-- PasswordRepetidaError
AuthServiceError <|-- ServicioNoDisponibleError
AuthServiceError <|-- SinSesionError
@enduml
