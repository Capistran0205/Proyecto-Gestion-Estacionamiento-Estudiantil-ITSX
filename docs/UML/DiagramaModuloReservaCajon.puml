@startuml ReservaCajon
title Módulo — Reserva de cajón (Reservar, Mi reserva, Admin de reservas, Escáner QR)
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package "Controller" {
  interface Vista <<Interface>> {
    +view : ft.View
    +montar()
    +desmontar()
  }
  class Router <<Controller>> {
    -_reservas : ReservasService
    -_almacen : AlmacenReserva
    -_cajon_a_reservar : str
    -_mi_reserva : MiReservaViewModel
    -_admin_reservas : AdminReservasViewModel
    -_inicio : InicioViewModel
    -_notificaciones : NotificacionesService
    -_dispositivos : DispositivosService
    -_token_fcm : str
    +ir(ruta : str)
    -_crear_reservar() : Vista
    -_crear_mi_reserva() : Vista
    -_crear_admin_reservas() : Vista
    -_crear_escaner() : Vista
    -_ir_a_reservar(etiqueta : str)
    -_es_administrador() : bool
    -_activar_notificaciones()
    -_registrar_token(token : str)
    -_quitar_token_push()
    -_aviso_en_primer_plano(aviso : AvisoPush)
    -_aviso_tocado(aviso : AvisoPush)
    -_ruta_de_aviso(aviso : AvisoPush) : str
  }
}

package "View" {
  class ReservarView <<View>> {
    +view : ft.View
    -_vm : ReservarViewModel
    -_progreso : ProgresoPasos
    -_tarjetas : list[TarjetaCajon]
    -_recuadro_1 : RecuadroCajon
    -_recuadro_2 : RecuadroCajon
    -_inicio : CampoFormulario
    -_fin : ft.Dropdown
    -_error_fin : MensajeError
    -_filas_resumen : list[_FilaResumen]
    -_banner_1 : BannerAlerta
    -_banner_2 : BannerAlerta
    -_banner_3 : BannerAlerta
    +montar()
    +desmontar()
    -_on_cambio()
    -_render()
    -_al_tocar(etiqueta_cajon : str) : Handler
    -_on_fin(e : ft.Event)
    -_on_continuar(e : ft.Event)
    -_on_cancelar(e : ft.Event)
    -_on_regresar(e : ft.Event)
    -_on_ver_reserva(e : ft.Event)
  }
  class MiReservaView <<View>> {
    +view : ft.View
    -_vm : MiReservaViewModel
    -_codigo_mostrado : str
    -_hoja_abierta : bool
    -_banner : BannerEstado
    -_alerta : BannerAlerta
    -_recuadro : RecuadroCajon
    -_qr : ft.Container
    -_tiempo : ft.Text
    -_extender : ft.OutlinedButton
    -_cancelar : ft.Control
    -_salida : ft.Control
    -_resultado : PantallaResultado
    -_hoja : ft.BottomSheet
    +montar()
    +desmontar()
    -_on_cambio()
    -_render()
    -_sincronizar_hoja()
    -_cerrar_hoja()
    -_on_regresar(e : ft.Event)
    -_on_cancelar(e : ft.Event)
    -_on_salida(e : ft.Event)
    -_on_extender(e : ft.Event)
    -_on_confirmar(e : ft.Event)
    -_on_mantener(e : ft.Event)
    -_on_resultado(e : ft.Event)
  }
  class AdminReservasView <<View>> {
    +view : ft.View
    -_vm : AdminReservasViewModel
    -_contadores : dict[FaseAdmin, _Contador]
    -_alerta : BannerAlerta
    -_lista : ft.Column
    -_escanear : ft.Control
    +montar()
    +desmontar()
    -_on_cambio()
    -_render()
    -_on_regresar(e : ft.Event)
    -_on_escanear(e : ft.Event)
  }
  class EscanerView <<View>> {
    +view : ft.View
    -_vm : EscanerViewModel
    -_con_camara : bool
    -_camara : flet_camera.Camera
    -_transmitiendo : bool
    -_linterna_activa : bool
    -_alerta : BannerAlerta
    -_codigo_manual : CampoFormulario
    -_resultado_mostrado : ResultadoEscaner
    +montar()
    +desmontar()
    -_on_cambio()
    -_render()
    -{static} _construir_resultado(r : ResultadoEscaner) : list[ft.Control]
    -_preparar_camara()
    -_sincronizar_camara()
    -_detener_transmision()
    -_on_cuadro(e)
    -_on_linterna(e : ft.Event)
    -_on_validar_manual(e : ft.Event)
    -_on_escanear_otro(e : ft.Event)
    -_on_ver_reservas(e : ft.Event)
  }
  package "components" {
    class TarjetaCajon <<View>> {
      +sincronizar(estado, texto_estado, tocable, seleccionada, atenuada)
    }
    class RecuadroCajon <<View>> {
      +mostrar(etiqueta : str, detalle : str)
    }
    class ProgresoPasos <<View>> {
      +sincronizar(paso : int)
    }
    class BannerEstado <<View>> {
      +mostrar(contenido : tuple[str, str], advertencia : bool)
    }
    class PantallaResultado <<View>> {
      +mostrar(titulo, detalle, boton, icono, color, fondo)
      +ocultar()
    }
    class BannerAlerta <<View>> {
      +mostrar(alerta : Alerta)
    }
    class CampoFormulario <<View>>
    class codigo_qr <<Utility>> {
      +{static} qr_png(codigo : str) : bytes
    }
  }
}

package "ViewModel" {
  package "Reservar" {
    enum PasoReserva {
      ELEGIR
      HORARIO
      CONFIRMAR
    }
    class CajonReserva <<DTO>> {
      +etiqueta : str
      +estado : EstadoCajon
      +texto_estado : str
      +seleccionado : bool
      +tocable : bool
    }
    class ReservarViewModel <<ViewModel>> {
      +ocupacion : OcupacionViewModel
      +paso : PasoReserva
      +bloqueo : BloqueoCajon
      +fin : datetime
      +alerta : Alerta
      +error_fin : str
      +cargando : bool
      +tiene_reserva_activa : bool
      +reserva : ReservaCajon
      -_auth : AuthService
      -_reservas : ReservasService
      -_almacen : AlmacenReserva
      -_etiqueta_inicial : str
      +/numero_paso : int
      +/etiqueta : str
      +/cajones : list[CajonReserva]
      +/hora_inicio : str
      +/opciones_fin : list[tuple[str, str]]
      +/duracion : str
      +/resumen : list[tuple[str, str]]
      +/avisos : list
      +/puede_ver_reserva : bool
      +iniciar()
      +liberar()
      +seleccionar(etiqueta : str)
      +set_fin(clave : str)
      +continuar()
      +confirmar()
      +regresar()
      +cancelar()
      +ver_reserva()
      -_error_al_bloquear(e : ReservaError)
      -_error_al_crear(e : ReservaError)
      -_soltar_bloqueo()
      -_liberar(id_cajon : int)
    }
  }
  package "Mi reserva" {
    enum PantallaReserva {
      CARGANDO
      ACTIVA
      CANCELADA
      EXPIRADA
      FINALIZADA
      SIN_RESERVA
      ERROR
    }
    enum FaseReserva {
      CONFIRMADA
      RETRASO
      EN_USO
    }
    enum Confirmacion {
      CANCELAR
      SALIDA
    }
    class "Resultado" as ResultadoMiReserva <<DTO>> {
      +titulo : str
      +detalle : str
      +boton : str
    }
    class MiReservaViewModel <<ViewModel>> {
      +pantalla : PantallaReserva
      +reserva : ReservaCajon
      +conectado : bool
      +alerta : Alerta
      +confirmacion : Confirmacion
      +procesando : bool
      +reglas : ReglasReserva
      -_auth : AuthService
      -_reservas : ReservasService
      -_almacen : AlmacenReserva
      -_aviso : AvisoDeCambios
      -_intervalo : int
      -_ciclo : asyncio.Task
      +/activa : bool
      +/fase : FaseReserva
      +/etiqueta : str
      +/banner : tuple[str, str]
      +/horario : str
      +/codigo_qr : str
      +/cronometro : tuple
      +/fin_proximo : bool
      +/aviso_fin : tuple[str, str]
      +/puede_cancelar : bool
      +/en_uso : bool
      +/resultado : ResultadoMiReserva
      +iniciar()
      +liberar()
      +actualizar()
      +pedir_cancelar()
      +pedir_salida()
      +descartar_confirmacion()
      +confirmar_accion()
      +extender()
      +regresar()
      +accion_resultado()
      -_correr()
      -_aplicar(servidor : ReservaCajon, id_usuario : str)
      -_revisar_tiempo()
      -_ejecutar(operacion, final : PantallaReserva, titulo_error : str)
      -_terminar(pantalla : PantallaReserva)
      -_guardar()
    }
  }
  package "Administración" {
    enum FaseAdmin {
      POR_LLEGAR
      EN_TOLERANCIA
      EN_USO
    }
    class FilaReserva <<DTO>> {
      +id_reserva : str
      +etiqueta : str
      +fase : FaseAdmin
      +titulo : str
      +detalle : str
      +tiempo : str
    }
    class AdminReservasViewModel <<ViewModel>> {
      +reservas : list[ReservaCajon]
      +reglas : ReglasReserva
      +cargando : bool
      +alerta : Alerta
      -_reservas : ReservasService
      -_aviso : AvisoDeCambios
      -_intervalo : int
      -_ciclo : asyncio.Task
      +/filas : list[FilaReserva]
      +/vacia : bool
      +iniciar()
      +liberar()
      +actualizar()
      +contar(fase : FaseAdmin) : int
      +escanear()
      +regresar()
      -_correr()
      -_fase(r : ReservaCajon) : FaseAdmin
      -_limite_tolerancia(r : ReservaCajon) : datetime
    }
    enum FaseEscaner {
      ESCANEANDO
      VALIDANDO
      RESULTADO
    }
    class "Resultado" as ResultadoEscaner <<DTO>> {
      +valido : bool
      +titulo : str
      +subtitulo : str
      +cajon : tuple[str, str]
      +motivo : tuple[str, str]
      +filas : list[tuple[str, str]]
      +fila_destacada : str
    }
    class EscanerViewModel <<ViewModel>> {
      +fase : FaseEscaner
      +resultado : ResultadoEscaner
      +linterna : bool
      +alerta : Alerta
      -_reservas : ReservasService
      -_lector : LectorQr
      -_reglas : ReglasReserva
      -_analizando : bool
      +/titulo : str
      +/escaneando : bool
      +procesar_cuadro(imagen : bytes)
      +validar(codigo : str)
      +cancelar_validacion()
      +alternar_linterna()
      +error_camara(mensaje : str)
      +escanear_otro()
      +ver_reservas()
      +regresar()
      -_confirmar(codigo : str)
      -_aceptado(llegada : LlegadaRegistrada) : ResultadoEscaner
      -_rechazo(codigo : str, e : ReservaError) : ResultadoEscaner
      -_buscar(codigo : str) : ReservaCajon
    }
  }
  package "Compartidos" {
    class OcupacionViewModel <<ViewModel>> {
      +/cajones : list[CajonVista]
      +cajon(etiqueta : str) : CajonVista
      +reservar(etiqueta : str)
    }
    class AvisoDeCambios <<ViewModel>> {
      -_ocupacion : OcupacionViewModel
      -_al_cambiar : Callable
      -_etiqueta : Callable
      -_ultima : tuple
      +escuchar()
      +dejar()
      -_firma() : tuple
      -_revisar()
    }
    class InicioViewModel <<ViewModel>> {
      +reserva : ReservaCajon
      +/tarjeta_reserva : TarjetaReserva
      +actualizar_reserva()
      +ir_a_mi_reserva()
      +ir_a_reservas()
    }
    class TarjetaReserva <<DTO>> {
      +subtitulo : str
      +en_uso : bool
    }
    class formato <<Utility>> {
      +{static} hora_local(fecha) : str
      +{static} cuenta_regresiva(restante) : str
      +{static} hh_mm_ss(restante) : str
      +{static} horas_totales(inicio, fin) : str
      +{static} id_corto(id_reserva) : str
    }
    class Alerta <<DTO>>
  }
}

package "Model" {
  package "services" {
    class ReservasService <<Service>> {
      -_token_factory : Callable[[], str]
      -_url_factory : Callable[[], tuple[str, str]]
      -_transporte : httpx.BaseTransport
      -_timeout : float
      +bloquear_cajon(id_cajon : int) : BloqueoCajon
      +liberar_bloqueo(id_cajon : int)
      +crear_reserva(id_cajon : int, inicio : datetime, fin : datetime) : ReservaCajon
      +cancelar_reserva(id_reserva : str)
      +extender_reserva(id_reserva : str) : datetime
      +confirmar_salida(id_reserva : str)
      +reglas() : ReglasReserva
      +confirmar_llegada(codigo_qr : str) : LlegadaRegistrada
      +reservas_activas() : list[ReservaCajon]
      +reserva_por_codigo(codigo_qr : str) : ReservaCajon
      +obtener_reserva(id_reserva : str) : ReservaCajon
      +reserva_vigente(id_usuario : str) : ReservaCajon
      -_consultar(filtros : dict, columnas : str) : ReservaCajon
      -_invocar(funcion : str, cuerpo : dict) : dict
      -_peticion(metodo : str, ruta : str, nombre : str) : Any
    }
    class ReservaError <<Exception>> {
      +codigo : str
      +mensaje : str
      +status : int
    }
    class ReservasNoDisponiblesError <<Exception>> {
      +sin_red : bool
    }
    class AlmacenReserva <<Repository>> {
      -_directorio : Path
      -/_ruta : Path
      +guardar(id_usuario : str, reserva : ReservaCajon)
      +leer(id_usuario : str) : ReservaCajon
      +borrar()
    }
    class LectorQr <<Service>> {
      -_lado_maximo : int
      -_detector : cv2.QRCodeDetector
      +leer(imagen : bytes) : str
      +{static} es_codigo_del_sistema(texto : str) : bool
    }
    class AuthService <<Service>> {
      +/usuario_actual : Usuario
      +/hay_sesion_activa : bool
      +token_acceso() : str
    }
  }
  package "Notificaciones push (en desarrollo, sin commit)" {
    class NotificacionesService <<Service>> {
      -_config : ConfigFirebase
      -_fabrica_fcm : Callable
      -_fcm : Any
      +/activa : bool
      +{static} soportada(page : ft.Page) : bool
      +iniciar(page, al_renovar_token, al_mensaje, al_tocar) : str
      +aviso_inicial() : AvisoPush
      +olvidar_token()
      -_token_renovado(e)
      -_mensaje_recibido(e)
      -_mensaje_tocado(e)
    }
    class AvisoPush <<DTO>> {
      +tipo : str
      +id_reserva : str
      +id_cajon : str
      +titulo : str
      +cuerpo : str
      +{static} desde(titulo, cuerpo, datos) : AvisoPush
      +{static} desde_evento(e) : AvisoPush
      +{static} desde_mapa(m : dict) : AvisoPush
    }
    class DispositivosService <<Service>> {
      -_token_factory : Callable[[], str]
      -_url_factory : Callable
      +registrar_token(token : str, plataforma : str)
      +borrar_token(token : str)
      -_peticion(metodo : str, ruta : str, nombre : str)
    }
    class ConfigFirebase <<Config>> {
      +api_key : str
      +app_id : str
      +sender_id : str
      +project_id : str
    }
  }
  package "models" {
    enum EstadoReserva {
      PENDIENTE_LLEGADA
      EN_USO
      FINALIZADA
      CANCELADA
      EXPIRADA
      +/vigente : bool
    }
    class ReservaCajon <<Entity>> {
      +id_reserva : str
      +id_cajon : int
      +codigo_qr : str
      +estado : EstadoReserva
      +fecha_inicio : datetime
      +fecha_fin : datetime
      +cronometro : datetime
      +fecha_llegada : datetime
      +etiqueta : str
      +minutos_tolerancia : int
      +fecha_usuario : datetime
      +aviso_fin_enviado : bool
      +fecha_cancelacion : datetime
      +/etiqueta_cajon : str
      +/limite_tolerancia : datetime
      +{static} from_dict(datos : dict) : ReservaCajon
      +to_dict() : dict
    }
    class BloqueoCajon <<Entity>> {
      +id_cajon : int
      +etiqueta : str
      +fecha_inicio : datetime
      +fin_minimo : datetime
      +fin_maximo : datetime
      +bloqueado_hasta : datetime
      +minutos_llegada : int
      +minutos_tolerancia : int
      +{static} from_dict(datos : dict) : BloqueoCajon
    }
    class ReglasReserva <<Entity>> {
      +minutos_llegada : int
      +minutos_tolerancia : int
      +minutos_aviso_fin : int
      +horas_maximas : int
      +{static} from_dict(datos : dict) : ReglasReserva
    }
    class LlegadaRegistrada <<Entity>> {
      +id_reserva : str
      +id_cajon : int
      +etiqueta : str
      +fecha_llegada : datetime
      +fecha_fin : datetime
      +medio_transporte : str
      +nombre_estudiante : str
      +{static} from_dict(datos : dict) : LlegadaRegistrada
    }
    enum EstadoCajon {
      LIBRE
      OCUPADO
      RESERVADO
      BLOQUEADO
      NO_CONECTADO
    }
  }
}

package "core" {
  class Observable <<Core>> {
    +add_listener(listener)
    +remove_listener(listener)
    +notify_listeners()
  }
}

' --- Controller ---
Router "1" *-- "0..*" Vista : _activas
Router ..> ReservarViewModel : <<create>>
Router ..> MiReservaViewModel : <<create>>
Router ..> AdminReservasViewModel : <<create>>
Router ..> EscanerViewModel : <<create>>
Router o-- ReservasService
Router o-- AlmacenReserva
Router o-- NotificacionesService
Router o-- DispositivosService
Router ..> AvisoPush : decide ruta destino
OcupacionViewModel ..> Router : al_reservar = _ir_a_reservar(etiqueta)

' --- View ---
Vista <|.. ReservarView
Vista <|.. MiReservaView
Vista <|.. AdminReservasView
Vista <|.. EscanerView
ReservarView --> ReservarViewModel : _vm / add_listener
MiReservaView --> MiReservaViewModel : _vm / add_listener
AdminReservasView --> AdminReservasViewModel : _vm / add_listener
EscanerView --> EscanerViewModel : _vm / add_listener
ReservarView *-- ProgresoPasos
ReservarView *-- "4" TarjetaCajon
ReservarView *-- "2" RecuadroCajon
ReservarView *-- "3" BannerAlerta
ReservarView *-- CampoFormulario
MiReservaView *-- BannerEstado
MiReservaView *-- RecuadroCajon
MiReservaView *-- PantallaResultado
MiReservaView *-- BannerAlerta
MiReservaView ..> codigo_qr : qr_png()
AdminReservasView *-- BannerAlerta
EscanerView *-- BannerAlerta
EscanerView *-- CampoFormulario : captura manual

' --- ViewModel ---
Observable <|-- ReservarViewModel
Observable <|-- MiReservaViewModel
Observable <|-- AdminReservasViewModel
Observable <|-- EscanerViewModel
Observable <|-- OcupacionViewModel
Observable <|-- InicioViewModel
ReservarViewModel o-- OcupacionViewModel : ocupacion (estados en vivo)
ReservarViewModel --> PasoReserva
ReservarViewModel ..> CajonReserva : <<create>>
ReservarViewModel --> BloqueoCajon : bloqueo
ReservarViewModel --> ReservasService
ReservarViewModel --> AlmacenReserva
ReservarViewModel --> AuthService
MiReservaViewModel *-- AvisoDeCambios
MiReservaViewModel --> PantallaReserva
MiReservaViewModel ..> FaseReserva
MiReservaViewModel --> Confirmacion
MiReservaViewModel ..> ResultadoMiReserva : <<create>>
MiReservaViewModel --> ReservaCajon : reserva
MiReservaViewModel --> ReglasReserva : reglas
MiReservaViewModel --> ReservasService
MiReservaViewModel --> AlmacenReserva
MiReservaViewModel --> AuthService
MiReservaViewModel ..> formato
AdminReservasViewModel *-- AvisoDeCambios
AdminReservasViewModel ..> FilaReserva : <<create>>
AdminReservasViewModel ..> FaseAdmin
AdminReservasViewModel --> ReservasService
AdminReservasViewModel ..> formato
EscanerViewModel --> FaseEscaner
EscanerViewModel ..> ResultadoEscaner : <<create>>
EscanerViewModel --> ReservasService
EscanerViewModel *-- LectorQr : _lector
EscanerViewModel ..> LlegadaRegistrada
EscanerViewModel ..> formato
InicioViewModel *-- AvisoDeCambios
InicioViewModel o-- OcupacionViewModel
InicioViewModel ..> TarjetaReserva : <<create>>
InicioViewModel --> ReservasService
InicioViewModel --> AlmacenReserva
AvisoDeCambios o-- OcupacionViewModel : add_listener(_revisar)
FilaReserva --> FaseAdmin
CajonReserva --> EstadoCajon
ReservarViewModel ..> Alerta
MiReservaViewModel ..> Alerta
EscanerViewModel ..> Alerta
AdminReservasViewModel ..> Alerta

' --- Model ---
ReservasService ..> AuthService : token_factory = token_acceso
ReservasService ..> ReservaCajon : <<create>>
ReservasService ..> BloqueoCajon : <<create>>
ReservasService ..> ReglasReserva : <<create>>
ReservasService ..> LlegadaRegistrada : <<create>>
ReservasService ..> ReservaError : raise
ReservasService ..> ReservasNoDisponiblesError : raise
AlmacenReserva ..> ReservaCajon : reserva_activa.json
ReservaCajon --> EstadoReserva
DispositivosService ..> AuthService : token_factory = token_acceso
DispositivosService ..> ReservaError : raise
NotificacionesService ..> ConfigFirebase
NotificacionesService ..> AvisoPush : <<create>>

note right of ReservasService
  Escrituras: Edge Functions
  POST /functions/v1/{bloquear-cajon, liberar-bloqueo,
  cancelar-reserva, extender-reserva, confirmar-salida,
  reglas-reserva, confirmar-llegada, ...}
  Lecturas: GET /rest/v1/reservas (PostgREST)
end note
@enduml
