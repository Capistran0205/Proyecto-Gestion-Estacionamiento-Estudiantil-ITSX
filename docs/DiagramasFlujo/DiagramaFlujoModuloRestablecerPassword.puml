@startuml FlujoRecuperarPassword
title Diagrama de flujo — Módulo Restablecimiento de contraseña\nProceso en tres pasos: correo, código de verificación y nueva contraseña (MVVM)

skinparam shadowing false
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #455A64
skinparam ActivityDiamondBackgroundColor #FFFDE7
skinparam ActivityDiamondBorderColor #455A64
skinparam ArrowColor #455A64
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #F9A825
skinparam swimlaneTitleFontStyle bold

' ============================================================
' Carriles (en orden): Estudiante | Router | RecuperarPasswordView |
' RecuperarPasswordViewModel | AuthService | Supabase | EmqxAdminService
' ============================================================

|#E3F2FD|Estudiante|
start
:Pulsa el enlace de recuperar contraseña en Login;

|#F3E5F5|Router|
:ir("recuperar")\n_crear_recuperar() crea RecuperarPasswordViewModel\ny le pasa AuthService, EmqxAdminService y el callback al login;

|#E8F5E9|RecuperarPasswordView|
:montar(): se suscribe al ViewModel con add_listener()\ny pinta con _render() el paso 1 Correo\nIndicadorPasos.sincronizar(paso);

' ============================================================
' PASO 1 — CORREO
' ============================================================
repeat
  |Estudiante|
  :Escribe su correo institucional;

  |RecuperarPasswordView|
  :CampoFormulario envía el cambio al ViewModel;

  |#FFF3E0|RecuperarPasswordViewModel|
  :set_correo(valor) y notify_listeners();

  |Estudiante|
  if (¿Pulsa volver al login?) then (sí)
    |RecuperarPasswordView|
    :_on_ir_a_login(e);
    |RecuperarPasswordViewModel|
    :ir_a_login() invoca el callback de navegación;
    |Router|
    :Navega a la pantalla de Login;
    |Estudiante|
    stop
  else (no, pulsa Enviar código)
    |RecuperarPasswordView|
    :_on_principal(e) recibe el clic del botón;
  endif

  |RecuperarPasswordViewModel|
  :enviar_codigo()\nnormalizar_correo() y validar_correo_institucional();

  if (¿Correo con formato válido y dominio institucional?) then (no)
    :Asigna error_correo;
    note right
      RF-02 y RNF-04: mensaje claro por
      formato inválido o dominio no institucional.
    end note
  else (sí)
    :cargando = verdadero\n_solicitar_codigo();
    |AuthService|
    :solicitar_restablecimiento(correo);
    |Supabase|
    :reset_password_for_email(correo)\nEnvía el código de verificación al correo;
    note right: RF-01 y RF-03

    if (¿Supabase aceptó la solicitud?) then (sí)
      |RecuperarPasswordViewModel|
      :_solicitar_codigo() retorna verdadero\n_iniciar_temporizador() con VIGENCIA_CODIGO_SEGUNDOS\npaso = CODIGO;
      note right: RNF-05 vigencia de 10 minutos
    else (no)
      |AuthService|
      switch (¿Motivo del rechazo?)
      case (Límite de correos)
        :Lanza LimiteCorreosError;
      case (Servicio no disponible)
        :Lanza ServicioNoDisponibleError;
      endswitch
      |RecuperarPasswordViewModel|
      :Captura el AuthServiceError\n_solicitar_codigo() retorna falso\nPrepara la Alerta correspondiente;
    endif
    :cargando = falso;
  endif

  |RecuperarPasswordView|
  :_on_cambio() → _render()\nMuestra errores o banner de alerta\no el paso 2 Código;

repeat while (¿Se avanzó al paso del código?) is (no) not (sí)

' ============================================================
' PASO 2 — CÓDIGO
' ============================================================
repeat
  |Estudiante|
  :Recibe el código en su correo\ny lo escribe en el campo numérico;

  |RecuperarPasswordView|
  :CampoFormulario envía el cambio al ViewModel;

  |RecuperarPasswordViewModel|
  :set_codigo(valor) y notify_listeners()\n_contar() actualiza segundos_restantes y texto_vencimiento;

  |Estudiante|
  if (¿Pulsa reenviar código?) then (sí)
    |RecuperarPasswordView|
    :_on_reenviar(e);
    |RecuperarPasswordViewModel|
    :reenviar_codigo() repite _solicitar_codigo()\ny reinicia el temporizador de vigencia;
    |AuthService|
    :solicitar_restablecimiento(correo);
    |Supabase|
    :reset_password_for_email(correo)\nEnvía un código nuevo;
  else (no, pulsa Verificar código)
    |RecuperarPasswordView|
    :_on_principal(e) recibe el clic del botón;
    |RecuperarPasswordViewModel|
    :verificar_codigo();

    if (¿El código está vencido por el temporizador?) then (sí)
      :codigo_invalido = verdadero\nmostrar_error_codigo = verdadero;
      note right: RF-04
    else (no)
      :cargando = verdadero;
      |AuthService|
      :verificar_codigo_recuperacion(correo, codigo);
      |Supabase|
      :verify_otp con tipo recovery;

      if (¿Código correcto y vigente?) then (sí)
        |AuthService|
        :Queda abierta una sesión temporal de recuperación;
        |RecuperarPasswordViewModel|
        :_codigo_verificado = verdadero\npaso = NUEVA_PASSWORD;
      else (no)
        |AuthService|
        switch (¿Motivo del rechazo?)
        case (Código no válido o vencido)
          :Lanza CodigoInvalidoError;
        case (Servicio no disponible)
          :Lanza ServicioNoDisponibleError;
        endswitch
        |RecuperarPasswordViewModel|
        :Captura el AuthServiceError\nCodigoInvalidoError activa codigo_invalido\nOtro error prepara una Alerta general;
        note right: RF-04
      endif
      :cargando = falso;
    endif
  endif

  |RecuperarPasswordView|
  :_on_cambio() → _render()\nBannerAlerta _banner_codigo avisa que el código\nno es válido o ya venció\no se muestra el paso 3 Nueva contraseña;

repeat while (¿Código verificado?) is (no) not (sí)

' ============================================================
' PASO 3 — NUEVA CONTRASEÑA
' ============================================================
repeat
  |Estudiante|
  :Escribe la nueva contraseña y su confirmación;

  |RecuperarPasswordView|
  :CampoFormulario envía el cambio al ViewModel;

  |RecuperarPasswordViewModel|
  :set_password y set_confirmar_password\n_revalidar_password() actualiza requisitos_password;

  |RecuperarPasswordView|
  :ListaRequisitos.sincronizar() marca los requisitos cumplidos;
  note right: RNF-01 y RN-02

  |Estudiante|
  if (¿Abandona el proceso?) then (sí)
    |RecuperarPasswordView|
    :_on_regresar(e) o _on_ir_a_login(e);
    |RecuperarPasswordViewModel|
    :regresar() o ir_a_login()\nliberar() detiene el temporizador;
    |AuthService|
    :cancelar_recuperacion()\nCierra la sesión temporal;
    |Router|
    :Navega a la pantalla de Login;
    |Estudiante|
    stop
  else (no, pulsa Guardar contraseña)
    |RecuperarPasswordView|
    :_on_principal(e) recibe el clic del botón;
  endif

  |RecuperarPasswordViewModel|
  :guardar_password()\nestado_requisitos_password() y comparación con la confirmación;

  if (¿Contraseña válida y confirmada?) then (no)
    :Asigna error_password o error_confirmar;
  else (sí)
    :cargando = verdadero;
    |AuthService|
    :confirmar_nueva_password(nueva);
    |Supabase|
    :update_user con la nueva contraseña;

    if (¿Supabase actualizó la contraseña?) then (sí)
      |AuthService|
      :Cierra la sesión temporal de recuperación;
      |RecuperarPasswordViewModel|
      :_sincronizar_mqtt();
      |EmqxAdminService|
      :crear_credencial(correo, nueva)\nLa contraseña MQTT queda igual a la nueva;
      if (¿EMQX devolvió un error?) then (sí)
        |RecuperarPasswordViewModel|
        :Solo se registra en el log\nel cambio de contraseña continúa;
      endif
      |RecuperarPasswordViewModel|
      :paso = COMPLETADO;
    else (no)
      |AuthService|
      switch (¿Motivo del rechazo?)
      case (Contraseña débil)
        :Lanza PasswordDebilError;
      case (Igual a la anterior)
        :Lanza PasswordRepetidaError;
      case (Sin sesión de recuperación)
        :Lanza SinSesionError;
      case (Servicio no disponible)
        :Lanza ServicioNoDisponibleError;
      endswitch
      |RecuperarPasswordViewModel|
      :Captura el AuthServiceError;
      switch (¿Tipo de excepción?)
      case (PasswordDebilError o PasswordRepetidaError)
        :Asigna error_password con el mensaje correspondiente;
      case (SinSesionError)
        :_reiniciar(alerta) regresa al paso 1\ncon el aviso de que la verificación expiró;
        |Estudiante|
        stop
      case (Otro AuthServiceError)
        :Prepara una Alerta general;
      endswitch
    endif
    |RecuperarPasswordViewModel|
    :cargando = falso;
  endif

  |RecuperarPasswordView|
  :_on_cambio() → _render()\nMuestra errores de campo, alerta\no la pantalla de éxito;

repeat while (¿Contraseña actualizada?) is (no) not (sí)

|RecuperarPasswordView|
:PantallaExito confirma que la contraseña fue restablecida;
note right: RF-05

|Estudiante|
:Pulsa para ir al login;

|RecuperarPasswordView|
:_on_ir_a_login(e);
|RecuperarPasswordViewModel|
:ir_a_login() invoca el callback de navegación;
|Router|
:Navega a la pantalla de Login;
|Estudiante|
stop

@enduml
